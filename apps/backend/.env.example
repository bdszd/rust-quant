# Local development PostgreSQL connection.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rust_quant

# Local development RabbitMQ AMQP connection.
AMQP_ADDR=amqp://rust_quant:rust_quant_dev@localhost:5673/%2f

# Per-process identity. Leave unset in local development to generate a UUID.
# Set a unique, stable value for each deployed Backend instance.
# RUST_QUANT_INSTANCE_ID=backend-1

# Number of RabbitMQ consumers started by this Backend instance.
# Default: 2. Set to 0 for an API/Publisher-only instance.
# RUST_QUANT_WORKER_COUNT=2

# Maximum PostgreSQL connections in this instance's pool.
# Multiply this value by the number of Backend instances when sizing PostgreSQL.
# Default: 10
# RUST_QUANT_DB_MAX_CONNECTIONS=10

# Local development runs migrations automatically by default.
# In multi-instance deployment, run one migration-only process first, then
# disable startup migrations on every serving instance.
# RUST_QUANT_RUN_MIGRATIONS=true
# RUST_QUANT_MIGRATE_ONLY=false

# Comma-separated exact browser origins allowed to call the Backend.
# No wildcard is allowed. Defaults to the local Vite dev server.
# In production, set this to the deployed frontend origin(s).
# RUST_QUANT_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

