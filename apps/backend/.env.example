# Local development PostgreSQL connection.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rust_quant

# Local development RabbitMQ AMQP connection.
AMQP_ADDR=amqp://rust_quant:rust_quant_dev@localhost:5673/%2f

# Optional cleaned market-data directory override.
# Default: <repository-root>/data/cleaned
# RUST_QUANT_DATA_DIR=/absolute/path/to/rust-quant/data/cleaned
